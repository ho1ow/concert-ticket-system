# ---- Database ----
DATABASE_URL=postgresql+psycopg://concert:concert@db:5432/concert
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000
AUTO_CREATE_SCHEMA=true
SQL_ECHO=false

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ISSUER=concert-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15

# ---- Business rules ----
HOLD_TTL_MINUTES=10
MAX_SEATS_PER_USER_PER_EVENT=4

# ---- Payment webhook ----
WEBHOOK_SECRET=change-me-webhook-secret
WEBHOOK_MAX_SKEW_SECONDS=300

# ---- Phase 2 benchmark switch: atomic | naive ----
HOLD_STRATEGY=atomic
